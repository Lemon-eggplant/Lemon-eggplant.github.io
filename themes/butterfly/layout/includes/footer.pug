#footer-wrap
  #ft
    .ft-item-1
      .t-top
        .t-t-l
          p.ft-t.t-l-t 格言🧬
          .bg-ad
            div
              | 有些鸟注定是不会被关在笼子里的，因为它们的每一片羽毛上都闪耀着自由的光辉✨
            .btn-xz-box
              a.btn-xz(href='https://github.com/Lemon-eggplant') 访问我的 Github
        .t-t-r
          p.ft-t.t-l-t 快速导航💡
          ul.ft-links
            li
              a(href='/archives/') 文章归档
              a(href='/categories/') 文章分类
            li
              a(href='/tags/') 文章标签
              a(href='/link/') 友情链接
            li
              a(href='/about/') 关于作者
              a(href='/comments/') 留点什么
    .ft-item-2
      p.ft-t 推荐友链⌛
      .ft-img-group
        //- 这里我帮你清空了原作者的友链，你可以自己添加，格式如下：
        //- .img-group-item
        //-   a(href='朋友网址' title='朋友名字')
        //-     img(src='朋友头像链接' alt='')
        .img-group-item
          a(href='https://butterfly.js.org/' title='Butterfly')
            img(src='https://lskypro.acozycotage.net/LightPicture/2022/12/64cc6a7d508026e1.png' alt='')
        .img-group-item
          a(href='javascript:void(0)' title='广告位招租')
            img(src='https://lskypro.acozycotage.net/LightPicture/2022/12/65307a5828af6790.webp' alt='')

  if theme.footer.owner.enable
    - var now = new Date()
    - var nowYear = now.getFullYear()
    if theme.footer.owner.since && theme.footer.owner.since != nowYear
      .copyright
        span!= `<b>&copy;${theme.footer.owner.since} - ${nowYear}</b>`
        span!= `<b>&nbsp;&nbsp;By ${config.author}</b>`
    else
       .copyright
         span!= `<b>&copy;${nowYear}</b>`
         span!= `<b>&nbsp;&nbsp;By ${config.author}</b>`
  if theme.footer.copyright
    .framework-info
      span= _p('footer.framework') + ' '
      a(href='https://hexo.io')= 'Hexo'
      span.footer-separator |
      span= _p('footer.theme') + ' '
      a(href='https://github.com/jerryc127/hexo-theme-butterfly')= 'Butterfly'
  if theme.footer.custom_text
    .footer_custom_text!=`${theme.footer.custom_text}`
    
  #workboard
  
  p#ghbdages
    //- 改成你真实的版本号
    a.github-badge(target='_blank' href="https://hexo.io/" style='margin-inline:5px' title="博客框架为Hexo 7.3.0")
      img(src="https://sourcebucket.s3.ladydaily.com/badge/Frame-Hexo-blue.svg" alt='')

    a.github-badge(target='_blank' href="https://butterfly.js.org/" style='margin-inline:5px' title="主题版本Butterfly 5.6.3")
      img(src="https://sourcebucket.s3.ladydaily.com/badge/Theme-Butterfly-6513df.svg" alt='')

    a.github-badge(target='_blank' href="https://github.com/Lemon-eggplant" style='margin-inline:5px' title="本网站源码由Github提供存储仓库")
      img(src="https://sourcebucket.s3.ladydaily.com/badge/Source-Github-d021d6.svg" alt='')